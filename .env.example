APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-supabase-publishable-or-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key
# Required for channel resolution only; known-channel Atom frontier reads do not use it.
YOUTUBE_API_KEY=server-only-youtube-data-api-key
MEDIA_MONITOR_SIDECAR_URL=https://private-sidecar.example
MEDIA_MONITOR_SIDECAR_AUDIENCE=https://private-sidecar.example
MEDIA_MONITOR_ENSURE_PATH=/configured/ensure
MEDIA_MONITOR_INSPECT_PATH=/configured/inspect
MEDIA_MONITOR_SUMMARY_PATH=/configured/summary
CHANNEL_SYNC_SCHEDULER_AUDIENCE=https://youtube-following-web-xyz.run.app/api/internal/sync-channels
CHANNEL_SYNC_SCHEDULER_SERVICE_ACCOUNT_EMAIL=youtube-following-scheduler@your-project.iam.gserviceaccount.com
DEMO_CHANNEL_UIDS=youtube-channel:UC0000000000000000000000
POLAR_ENVIRONMENT=sandbox
POLAR_ACCESS_TOKEN=server-only-polar-access-token
POLAR_PRODUCT_ID=polar-monthly-product-id
POLAR_WEBHOOK_SECRET=server-only-polar-webhook-secret
PAID_FOLLOW_LIMIT=30
PAID_GENERATION_MINUTES_LIMIT=600
